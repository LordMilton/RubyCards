{
  "game": {
    "name": "Sample Hearts",
    "deck": {
      "cards": {
        "fail": [
          ["hearts_ace", "spades_ace", "clubs_ace", "diamonds_ace"],
          ["hearts_king", "spades_king", "clubs_king", "diamonds_king"],
          ["hearts_queen", "spades_queen", "clubs_queen", "diamonds_queen"],
          ["hearts_jack", "spades_jack", "clubs_jack", "diamonds_jack"],
          ["hearts_10", "spades_10", "clubs_10", "diamonds_10"],
          ["hearts_9", "spades_9", "clubs_9", "diamonds_9"],
          ["hearts_8", "spades_8", "clubs_8", "diamonds_8"],
          ["hearts_7", "spades_7", "clubs_7", "diamonds_7"],
          ["hearts_6", "spades_6", "clubs_6", "diamonds_6"],
          ["hearts_5", "spades_5", "clubs_5", "diamonds_5"],
          ["hearts_4", "spades_4", "clubs_4", "diamonds_4"],
          ["hearts_3", "spades_3", "clubs_3", "diamonds_3"],
          ["hearts_2", "spades_2", "clubs_2", "diamonds_2"]
        ]
      },
      "visible": false
    },
    "discard": {
      "visible": false
    },
    "players": [
      "N",
      "E",
      "S",
      "W"
    ],
    "scoring": {
      "method_1": {
        "card_scores": {
          "hearts_ace": 1,
          "hearts_king": 1,
          "hearts_queen": 1,
          "hearts_jack": 1,
          "hearts_10": 1,
          "hearts_9": 1,
          "hearts_8": 1,
          "hearts_7": 1,
          "hearts_6": 1,
          "hearts_5": 1,
          "hearts_4": 1,
          "hearts_3": 1,
          "hearts_2": 1,
          "spades_queen": 13
        },
        "transform_1": {
          "condition": {
            "subject": "hand_score",
            "comparison": 2,
            "comparators": ["equal"]
          },
          "transformation": {
            "current_player": {
              "action": "set",
              "value": 0
            },
            "other_players": {
              "action": "add",
              "value": 26
            }
          }
        }
      }
    }
  },
  "step_1": {
    "action": "setup",
    "change_1": {
      "action": "reset",
      "subject": "hand"
    },
    "change_2": {
      "action": "reset",
      "subject": "won_cards"
    },
    "change_3": {
      "action": "shuffle_deck"
    },
    "change_4": {
      "action": "draw",
      "amount": 2
    }
  },
  "step_2": {
    "action": "actionable",
    "actionables": {
      "action_1": {
        "action": "play",
        "count": 1
      }
    }
  },
  "step_3": {
    "action": "repeat_until",
    "from_step": 2,
    "change": {
      "subject": "player",
      "change": "next"
    },
    "condition": {
      "type": "occurrences",
      "comparison": 4,
      "comparators": ["equal"]
    }
  },
  "step_4": {
    "action": "assign_trick",
    "remove_trick": true
  },
  "step_5": {
    "action": "repeat_until",
    "from_step": 2,
    "change": {
      "subject": "player",
      "change": "last_winner"
    },
    "condition": {
      "type": "hand_size",
      "comparison": 0,
      "comparators": ["equal"]
    }
  },
  "step_6": {
    "action": "score",
    "subject": "won_cards",
    "method": 1
  },
  "step_7": {
    "action": "repeat_until",
    "from_step": 1,
    "change": {
      "subject": "dealer",
      "change": "next"
    },
    "condition": {
      "type": "score",
      "comparison": 100,
      "comparators": ["equal", "greater"]
    }
  },
  "step_8": {
    "action": "assign_winner",
    "condition": {
      "type": "score",
      "comparison": "lowest"
    }
  }
}